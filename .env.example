# Copy this file to .env.local and use the apiUrl shown for your instance in GREEN-API.
# This host is read by the Vite development server only; do not put idInstance or apiTokenInstance here.
GREEN_API_URL=https://api.green-api.com
# Used only by `npm run check:green-api`; never commit your real values.
GREEN_API_ID=
GREEN_API_TOKEN=
